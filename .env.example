# Скопируйте этот файл в .env и подставьте свой пароль от PostgreSQL.
# Файл .env в репозиторий не попадает - он в .gitignore.

DATABASE_URL=postgresql+psycopg://postgres:ВАШ_ПАРОЛЬ@localhost:5432/purpjob

# Срок жизни сессии в днях.
SESSION_TTL_DAYS=30

# На проде, где сайт работает по HTTPS, поставить True.
COOKIE_SECURE=False

# Как открывается регистрация: invite (закрытый пилот, нужен код) или open.
# По умолчанию invite. Открывать регистрацию публично нельзя, пока почта не
# подтверждается: любой завёл бы профиль на чужой адрес.
REGISTRATION_MODE=invite

# Код приглашения закрытого пилота. Пустой код означает "регистрация закрыта",
# а не "пускать всех". Подберите длинный - он общий на весь пилот.
PILOT_INVITE_CODE=
